GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Sandbox credentials only. Never put the client secret in the mobile app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Reachable backend URL for browser return pages; phone: use your computer's LAN IP.
PUBLIC_API_URL=http://localhost:8000
PUBLIC_APP_URL=
GROQ_MODEL=openai/gpt-oss-20b
# Enable YouTube Data API v3 in Google Cloud, then add its server-side API key.
YOUTUBE_API_KEY=
# Exercise animation previews; keep this key server-side.
WORKOUTX_API_KEY=
# Wikimedia catalog GIFs + YouTube by default. Set workoutx to resume its trial.
DEMONSTRATION_PROVIDER=wikimedia
# Exact browser origins, comma separated. Native apps do not use browser CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006
# Optional replacement JSON catalog when deploying backend separately.
# EXERCISE_CATALOG_PATH=/absolute/path/catalog.json
