# Public backend URL only. NEVER put GROQ_API_KEY or other secrets here.
# Browser/iOS Simulator: http://localhost:8000
# Android emulator: http://10.0.2.2:8000
# Physical phone: http://YOUR_COMPUTER_LAN_IP:8000 (same Wi-Fi)
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=
# Publishable key only; never a service-role/secret key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional publicly reachable WEB app origin; add /recover to Supabase redirect allowlist.
EXPO_PUBLIC_AUTH_REDIRECT_URL=
# Leave unset for Wikimedia/illustrations + YouTube. Set workoutx only to resume that trial.
EXPO_PUBLIC_DEMONSTRATION_PROVIDER=wikimedia
